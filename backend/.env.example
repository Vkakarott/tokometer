# Shared secret the collector uses on POST /ingest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKESP_COLLECTOR_TOKEN=change-me

# Shown on the device display so you know where to type the pairing code. Use
# the machine's Bonjour name (`scutil --get LocalHostName`) so it survives a
# new DHCP lease.
TOKESP_VERIFICATION_URI=http://<NOME-DA-MAQUINA>.local:43111/pair

PORT=43110
TOKESP_STATE_FILE=./state.json
TOKESP_STALE_AFTER_SECONDS=900

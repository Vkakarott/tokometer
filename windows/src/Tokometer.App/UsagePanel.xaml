<Window x:Class="Tokometer.App.UsagePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tokometer" Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True">
    <Window.Resources>
        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Track}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Background}" CornerRadius="10" Padding="14" Margin="0,0,0,0"
            BorderBrush="{StaticResource Track}" BorderThickness="1">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" x:Name="UpdatedText" Foreground="{StaticResource Muted}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="TOKOMETER" FontWeight="Bold" FontSize="14" />
            </DockPanel>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       Text="Nenhum provedor visível. Ative um em Ajustes, no menu do ícone." />
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" Fill="{Binding Accent}" Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Card.Name}" FontWeight="SemiBold" FontSize="13" />
                                </DockPanel>
                                <TextBlock Text="{Binding Card.Status}" Foreground="{Binding StatusBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="16,2,0,6" />
                                <ItemsControl ItemsSource="{Binding Card.Rows}" Margin="16,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResetsIn}"
                                                               Foreground="{StaticResource Muted}" FontSize="11"
                                                               Margin="8,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Fill, Mode=OneWay}"
                                                             Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>

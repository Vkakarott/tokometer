<Application x:Class="Tokometer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Background" Color="#FF15181D" />
        <SolidColorBrush x:Key="Surface" Color="#FF1F242B" />
        <SolidColorBrush x:Key="Track" Color="#FF2E343D" />
        <SolidColorBrush x:Key="Text" Color="#FFF2F4F7" />
        <SolidColorBrush x:Key="Muted" Color="#FF9AA3AF" />
        <SolidColorBrush x:Key="Warning" Color="#FFF5A524" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
    </Application.Resources>
</Application>
